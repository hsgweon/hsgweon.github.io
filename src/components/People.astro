---
import { currentMembers, groupPhotos, pastMembers } from '../data/people.js';

const initials = (name) =>
  name.split(' ').filter(Boolean).slice(0, 2).map((n) => n[0]).join('').toUpperCase();

// Group past members by role in this order (the role is the 2nd '·' field).
// Stable sort keeps the listed order within each role group.
const roleOrder = ['PhD', 'MSc', 'UROP', 'Undergraduate'];
const roleRank = (entry) => {
  const role = (entry.split('·')[1] || '').trim();
  const i = roleOrder.indexOf(role);
  return i === -1 ? roleOrder.length : i;
};
const sortedPastMembers = [...pastMembers].sort((a, b) => roleRank(a) - roleRank(b));
---

<section class="section" id="people">
  <div class="container">
    <p class="eyebrow" data-reveal>// people</p>
    <h2 class="section-title" data-reveal>The team</h2>
    <p class="section-lead" data-reveal data-delay="1">Current doctoral researchers driving the lab's work forward.</p>

    <div class="members">
      {currentMembers.map((p, i) => (
        <article class="member" data-reveal data-delay={(i % 3) + 1}>
          <div class="avatar">
            {p.photo ? <img src={p.photo} alt={p.name} loading="lazy" /> : <span>{initials(p.name)}</span>}
          </div>
          <div>
            <h3 class="member-name">{p.name}</h3>
            <p class="member-role">{p.role}</p>
          </div>
        </article>
      ))}
    </div>

    {groupPhotos.length > 0 && (
      <div class="gallery" data-reveal>
        {groupPhotos.map((g) => (
          <figure class="shot">
            <img src={g.src} alt={g.caption} loading="lazy" />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <details class="alumni" data-reveal>
      <summary>
        <span class="alumni-label">Past members &amp; students</span>
        <span class="alumni-count">{pastMembers.length}</span>
        <span class="alumni-chev">↓</span>
      </summary>
      <ul class="alumni-list">
        {sortedPastMembers.map((m) => <li>{m}</li>)}
      </ul>
    </details>
  </div>
</section>

<style>
  .members { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 46px; }
  .member { display: flex; gap: 16px; align-items: flex-start; border: 1px solid var(--line); background: var(--bg-panel); border-radius: var(--radius); padding: 22px; transition: border-color 0.3s ease, transform 0.3s ease; }
  .member:hover { border-color: var(--accent); transform: translateY(-3px); }
  .avatar { flex: 0 0 54px; width: 54px; height: 54px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: linear-gradient(145deg, var(--accent-deep), var(--accent)); color: #fff; font-family: var(--font-mono); font-weight: 600; font-size: 1rem; border: 1px solid var(--line-strong); }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .member-name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: #fff; margin-bottom: 6px; }
  .member-role { color: var(--ink-dim); font-size: 0.86rem; line-height: 1.55; }

  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 28px; }
  .shot { position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .shot img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; filter: grayscale(0.25); transition: filter 0.5s ease, transform 0.6s ease; }
  .shot:hover img { filter: grayscale(0); transform: scale(1.03); }
  .shot figcaption { position: absolute; left: 12px; bottom: 12px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink); background: rgba(5,5,6,0.72); backdrop-filter: blur(6px); padding: 5px 11px; border-radius: 100px; border: 1px solid var(--line); }

  .alumni { margin-top: 34px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-soft); overflow: hidden; }
  .alumni summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 14px; padding: 20px 24px; font-family: var(--font-mono); }
  .alumni summary::-webkit-details-marker { display: none; }
  .alumni-label { color: var(--ink); font-size: 0.92rem; }
  .alumni-count { font-size: 0.75rem; color: var(--accent-soft); border: 1px solid var(--line); border-radius: 100px; padding: 2px 10px; }
  .alumni-chev { margin-left: auto; color: var(--ink-faint); transition: transform 0.3s ease; }
  .alumni[open] .alumni-chev { transform: rotate(180deg); }
  .alumni-list { list-style: none; padding: 4px 24px 24px; columns: 2; column-gap: 32px; }
  .alumni-list li { break-inside: avoid; color: var(--ink-dim); font-size: 0.85rem; padding: 7px 0; border-top: 1px solid var(--line); }

  @media (max-width: 880px) { .members { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .members, .gallery, .alumni-list { grid-template-columns: 1fr; columns: 1; } }
</style>
